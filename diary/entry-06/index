<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Daph’s Digital Diary — Entry 005</title>

  <!-- Typography -->
  <link href="https://fonts.googleapis.com/css2?family=Audiowide&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      --ink: #121212;
      --muted: rgba(18,18,18,0.6);
      --bone: #f6f4ef;
      --chrome: #b7b7b7;
      --sage: #B7CBB8;
      --sage-dark: #9CAD9D;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bone);
      color: var(--ink);
      font-family: 'Outfit', sans-serif;
      line-height: 1.7;
    }

    .home-link {
      position: fixed;
      top: 24px;
      left: 24px;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--muted);
    }

    main {
      max-width: 680px;
      margin: 0 auto;
      padding: 120px 24px 160px;
    }

    h1, h2 {
      font-family: 'Audiowide', sans-serif;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 { font-size: 1.4rem; margin-bottom: 64px; }
    h2 { font-size: 1rem; margin-bottom: 64px; }

    .entry p {
      margin: 0 0 1.25em;
    }

    .divider {
      text-align: center;
      margin: 64px 0;
      color: var(--muted);
      letter-spacing: 0.2em;
    }

    footer {
      margin-top: 120px;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: center;
    }
  </style>
</head>

<body>

<a href="/bare-vision-world/diary/" class="home-link">← Diary</a>

<main>
  <h1>Daph’s Digital Diary</h1>

  <div class="soundtrack">
    <span class="soundtrack-label">s n d t r @ c k</span>
    <div class="soundtrack-row">
      <span class="soundtrack-title">Saturn Return — Zara Larrson </span>
   
    <audio id="soundtrackAudio" preload="metadata">
<source src="assets/audio/saturn-return.mp3" type="audio/mpeg">
</audio>
      
    <button
  class="soundtrack-btn"
  id="soundToggle"
  aria-label="Play soundtrack"
  data-fallback="https://www.youtube.com/watch?v=EILNC5EraZY"
>
  ▷
</button>
    </div>
  </div>

  <article class="entry">
    <h2>The way energy moves between us</h2>

<p>
    
<p>─── ⋆⋅☆⋅⋆ ──</p>

<p>Keep it simple, stupid</p>
    
<p>BiSOUS,</p>

<p>D x</p>

    
  </article>

  <footer>
    Daph’s Digital Diary ‧₊˚🖇️✩ ₊˚🎧⊹♡
  </footer>
</main>
  
<script>
  const audio = document.getElementById("soundtrackAudio");
  const toggle = document.getElementById("soundToggle");
  const fallbackURL = toggle.dataset.fallback;

  toggle.addEventListener("click", () => {
    audio.load();

    if (!audio.paused) {
      audio.pause();
      toggle.textContent = "▷";
      return;
    }

    audio.play().then(() => {
      toggle.textContent = "⏸";
    }).catch(() => {
      window.open(fallbackURL, "_blank", "noopener");
    });
  });
</script>

  
</body>
</html>
